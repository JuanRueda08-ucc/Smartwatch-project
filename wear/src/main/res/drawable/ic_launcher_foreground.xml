<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono de TickGo (tarea 5.3): un reloj que ya arrancó. Anillo casi completo (el tiempo que avanza), una marca
  a las 12 como en la esfera de un reloj ("tick") y una flecha hacia adelante ("go"). Todo dentro del círculo
  seguro de 66 dp del ícono adaptable, con trazos de 5 dp para que se lea a 48 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Anillo: de las 12 en el sentido del reloj hasta las 10, deja un hueco que sugiere movimiento. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32 A22,22 0 1,1 34.95,43"
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- Marca de las 12. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,39.5 L54,43.5"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- Flecha "go". -->
    <path
        android:fillColor="#00000000"
        android:pathData="M45,56 L62,56 M56.5,50.5 L62,56 L56.5,61.5"
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
